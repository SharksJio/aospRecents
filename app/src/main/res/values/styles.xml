<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#202124</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#4285F4</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Overview action button style -->
    <style name="OverviewActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <!-- Theme control highlight workspace color -->
    <style name="ThemeControlHighlightWorkspaceColor">
        <item name="colorControlHighlight">@color/workspace_color_highlight</item>
    </style>
</resources>
