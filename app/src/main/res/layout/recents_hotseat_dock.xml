<?xml version="1.0" encoding="utf-8"?>
<!-- Recents HotSeat Dock - Simplified for Standalone App -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recents_hotseat_dock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|bottom"
    android:layout_marginBottom="@dimen/recents_dock_margin_bottom"
    android:orientation="horizontal"
    android:background="@drawable/recents_dock_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:elevation="8dp">

    <!-- App Drawer Icon -->
    <ImageButton
        android:id="@+id/dock_app_drawer"
        android:layout_width="@dimen/recents_dock_icon_size"
        android:layout_height="@dimen/recents_dock_icon_size"
        android:layout_margin="@dimen/recents_dock_icon_margin"
        android:src="@android:drawable/ic_menu_view"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/all_apps_button_label"
        android:scaleType="centerInside" />

    <!-- App Icon Placeholders (6 apps) -->
    <ImageButton
        android:id="@+id/dock_app_1"
        android:layout_width="@dimen/recents_dock_icon_size"
        android:layout_height="@dimen/recents_dock_icon_size"
        android:layout_margin="@dimen/recents_dock_icon_margin"
        android:src="@android:drawable/sym_def_app_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <ImageButton
        android:id="@+id/dock_app_2"
        android:layout_width="@dimen/recents_dock_icon_size"
        android:layout_height="@dimen/recents_dock_icon_size"
        android:layout_margin="@dimen/recents_dock_icon_margin"
        android:src="@android:drawable/sym_def_app_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <ImageButton
        android:id="@+id/dock_app_3"
        android:layout_width="@dimen/recents_dock_icon_size"
        android:layout_height="@dimen/recents_dock_icon_size"
        android:layout_margin="@dimen/recents_dock_icon_margin"
        android:src="@android:drawable/sym_def_app_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <ImageButton
        android:id="@+id/dock_app_4"
        android:layout_width="@dimen/recents_dock_icon_size"
        android:layout_height="@dimen/recents_dock_icon_size"
        android:layout_margin="@dimen/recents_dock_icon_margin"
        android:src="@android:drawable/sym_def_app_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <ImageButton
        android:id="@+id/dock_app_5"
        android:layout_width="@dimen/recents_dock_icon_size"
        android:layout_height="@dimen/recents_dock_icon_size"
        android:layout_margin="@dimen/recents_dock_icon_margin"
        android:src="@android:drawable/sym_def_app_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <ImageButton
        android:id="@+id/dock_app_6"
        android:layout_width="@dimen/recents_dock_icon_size"
        android:layout_height="@dimen/recents_dock_icon_size"
        android:layout_margin="@dimen/recents_dock_icon_margin"
        android:src="@android:drawable/sym_def_app_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

</LinearLayout>
