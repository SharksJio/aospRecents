<?xml version="1.0" encoding="utf-8"?>
<!-- Overview Actions Container - Simplified for Standalone App -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overview_actions_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="16dp"
    android:background="#80000000">

    <!-- Action Buttons Container -->
    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/overview_actions_height"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Screenshot Button -->
        <Button
            android:id="@+id/action_screenshot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_screenshot"
            android:drawableStart="@drawable/ic_select"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            style="?android:attr/borderlessButtonStyle" />

        <!-- Select Button -->
        <Button
            android:id="@+id/action_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overview_actions_button_spacing"
            android:text="@string/action_select"
            android:drawableStart="@drawable/ic_select"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            style="?android:attr/borderlessButtonStyle" />

        <!-- Split Button -->
        <Button
            android:id="@+id/action_split"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/overview_actions_button_spacing"
            android:text="@string/action_split"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="visible"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

</LinearLayout>
